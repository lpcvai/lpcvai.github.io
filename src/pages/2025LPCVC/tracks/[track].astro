---
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [
    { params: { track: "track1" } },
    { params: { track: "track2" } },
    { params: { track: "track3" } },
  ];
}

const { track } = Astro.params as { track: "track1" | "track2" | "track3" };

// Track titles
const trackTitles = {
  track1: "Image classification for different lighting conditions and styles",
  track2: "Open-vocabulary segmentation with text prompt",
  track3: "Monocular relative depth estimation",
};

const trackFiles = import.meta.glob('../../../content/2025_tracks/*.html', {
  as: 'raw',
  eager: true,
});

const htmlPath = `../../../content/2025_tracks/${track}.html`;
const htmlContent = trackFiles[htmlPath] ?? `<p>Track content not available.</p>`;
---


<Layout>
  <main>
    <section id="facts">
      <div class="container">
        <header class="section-header text-center" id="data">
          <!-- Year-specific header -->
          <h3>2025 IEEE LOW-POWER COMPUTER VISION CHALLENGE</h3>

          <!-- Track dropdown -->
          <h4 class="track-title">
            <select
              onchange={`location.replace("/2025LPCVC/tracks/"+this.value);`}
            >
              <option value="track1" selected={track === "track1"}>Track 1</option>
              <option value="track2" selected={track === "track2"}>Track 2</option>
              <option value="track3" selected={track === "track3"}>Track 3</option>
            </select>
            &nbsp;<strong>{trackTitles[track]}</strong>
          </h4>
        </header>

        <div class="card mx-auto" style="max-width: 900px;">
          <div class="card-body">
            <div class="track-content" set:html={htmlContent}></div>
          </div>
        </div>

        <div class="pb-4"></div>
      </div>
    </section>
  </main>
</Layout>
