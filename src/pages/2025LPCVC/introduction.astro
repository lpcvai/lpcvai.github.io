---
import Layout from "../../layouts/Layout.astro";
import rawHtml from '../../content/2025_tracks/introduction.html?raw';
---

<Layout>
  <main>
    <section id="facts">
      <div class="container">
        <header class="section-header text-center" id="data">
          <!-- Year-specific header -->
          <h3>2025 IEEE LOW-POWER COMPUTER VISION CHALLENGE</h3>
          <!-- Page title -->
          <h4 class="p-0"><strong>Introduction</strong></h4>
        </header>

        <div class="card mx-auto" style="max-width: 900px;">
          <div class="card-body">
            <div class="track-content" set:html={rawHtml} />
          </div>
        </div>
        
        <div class="pb-4"></div>
      </div>
    </section>
  </main>
</Layout>
