---
import Layout from "../../../layouts/Layout.astro";
const failedJobsCsvUrl = "https://docs.google.com/spreadsheets/d/e/2PACX-1vQp6_wtdbRMDF6xwkBOSqJ9UvKRkk5WNKpxUD7ZYkejWXMf5ZQ0mnfxFXt1umuw0M3kHXQxY2oR0bOg/pub?output=csv";
const failedJobsCompetitionUrl = "/leaderboards/c2026/FailedJobs.json";
---

<Layout>
  <main><section id="facts"><div class="container">
    <header class="section-header"><h3>2026 IEEE LPCVC Leaderboard</h3>
      <div class="leaderboard-controls"><div class="view-toggle" role="group" aria-label="Leaderboard type"><button type="button" data-view="competition">Competition</button><button type="button" data-view="open">Open Submission</button></div>
      <select id="contest-select" aria-label="Leaderboard track"><option value="track1">Track 1</option><option value="track2">Track 2</option><option value="track3">Track 3</option><option value="failed" selected>Failed Jobs</option></select></div>
    </header>
    <div class="leaderboard-card"><h4>Failed Jobs</h4><div id="failed-status" class="status-text">Loading...</div><div class="table-wrapper"><table id="failed-table" class="leaderboard-table"></table></div></div>
    <script define:vars={{ failedJobsCsvUrl, failedJobsCompetitionUrl }}>
      const view = new URLSearchParams(window.location.search).get("view") === "open" ? "open" : "competition";
      const escapeHtml = (value) => String(value).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");
      function parseCSVLine(line) { const values=[], chars=line.match(/("(?:""|[^"])*"|[^,]*)(,|$)/g)||[]; chars.forEach((part)=>values.push(part.replace(/,$/,"").replace(/^"|"$/g,"").replace(/""/g,"\""))); return values; }
      function renderTable(rows, message) { const table=document.getElementById("failed-table"), status=document.getElementById("failed-status"); if(!rows?.length){table.innerHTML="";status.textContent="No data available.";return;} const headers=Array.isArray(rows[0])?rows[0]:Object.keys(rows[0]), data=Array.isArray(rows[0])?rows.slice(1):rows; table.innerHTML=`<thead><tr>${headers.map((h)=>`<th>${escapeHtml(h)}</th>`).join("")}</tr></thead><tbody>${data.map((row)=>`<tr>${headers.map((h,i)=>`<td>${escapeHtml(Array.isArray(row)?row[i]??"":row[h]??"")}</td>`).join("")}</tr>`).join("")}</tbody>`; status.textContent=message; }
      async function loadFailedJobs() { const competition=view==="competition", status=document.getElementById("failed-status"); try { status.textContent="Loading..."; const response=await fetch(competition?failedJobsCompetitionUrl:failedJobsCsvUrl,{cache:competition?"force-cache":"no-store"}); if(!response.ok) throw new Error(`HTTP ${response.status}`); const rows=competition?await response.json():(await response.text()).split(/\r?\n/).filter(Boolean).map(parseCSVLine); renderTable(rows,competition?"Final competition results":`Last updated: ${new Date().toLocaleString()}`); } catch(error) { console.error("Failed to load failed jobs data:",error); status.textContent="Failed to load failed jobs data."; } }
      document.querySelectorAll("[data-view]").forEach((button)=>{const active=button.dataset.view===view;button.classList.toggle("active",active);button.setAttribute("aria-pressed",String(active));button.addEventListener("click",()=>window.location.href=`/2026LPCVC/leaderboard/failed?view=${button.dataset.view}`);});
      document.getElementById("contest-select").addEventListener("change",(event)=>window.location.href=`/2026LPCVC/leaderboard/${event.target.value}${view==="open"?"?view=open":""}`);
      loadFailedJobs(); if(view==="open") setInterval(loadFailedJobs,10000);
    </script>
  </div></section></main>
</Layout>

<style>
  #facts { padding:20px; } .container { max-width:1200px; margin:0 auto; } .section-header { margin-bottom:20px; } .leaderboard-controls { display:flex; align-items:center; gap:12px; flex-wrap:wrap; } .view-toggle { display:inline-flex; border:1px solid #ccc; border-radius:4px; overflow:hidden; } .view-toggle button { border:0; padding:7px 12px; background:#fff; cursor:pointer; } .view-toggle button:not(:first-child) { border-left:1px solid #ccc; } .view-toggle button.active { background:#333; color:#fff; } select { padding:5px; border:1px solid #ccc; border-radius:4px; } .leaderboard-card { border:1px solid #ccc; padding:20px; border-radius:8px; box-shadow:0 2px 4px rgba(0,0,0,.1); background:#fff; } .status-text { margin-bottom:12px; font-size:14px; color:#666; } .table-wrapper { overflow-x:auto; } .leaderboard-table { width:100%; border-collapse:collapse; font-size:14px; } .leaderboard-table th, .leaderboard-table td { border:1px solid #ddd; padding:10px 12px; text-align:left; white-space:nowrap; } .leaderboard-table th { background:#f5f5f5; font-weight:600; } .leaderboard-table tbody tr:nth-child(even) { background:#fafafa; }
</style>
