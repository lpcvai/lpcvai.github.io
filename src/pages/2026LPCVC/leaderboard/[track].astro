---
import Layout from "../../../layouts/Layout.astro";

export async function getStaticPaths() {
  return [
    { params: { track: "track1" } },
    { params: { track: "track2" } },
    { params: { track: "track3" } },
  ];
}

const { track } = Astro.params;

const qualifiedCsvUrls = {
  track1: "https://docs.google.com/spreadsheets/d/e/2PACX-1vQMFrDUJ6RHEVXpBPtXULj-GMpnklXMu-eueuqysxa4F5vLeBQyy4e52cBAghFTnDO0JUR8NjCy6YNE/pub?gid=0&single=true&output=csv",
  track2: "https://docs.google.com/spreadsheets/d/e/2PACX-1vRS8ykHnrAv7VXaqKLkjVF_ltRx5s5JiL-U-0tZcd26dNnbIEPh9zrbAL2phZZAH0jBXu5Z-nrt-jcl/pub?gid=0&single=true&output=csv",
  track3: "https://docs.google.com/spreadsheets/d/e/2PACX-1vRgXRdZ2e0E3epHwIzEXEwiLbG2hCwJT-VBJtqANN7ISojrSGN9R595hXLlBif0ZjXKjFyz6nr4hSap/pub?gid=0&single=true&output=csv",
};

const disqualifiedCsvUrls = {
  track1: "https://docs.google.com/spreadsheets/d/e/2PACX-1vQpk4jA2Ll2NMCI41oymTDCJP5kR4PuZsBtslkVfkqxLQ1eTIaq5BKNYpGv-a2NFGEN_Sdep4PDhc7Y/pub?gid=0&single=true&output=csv",
  track2: "https://docs.google.com/spreadsheets/d/e/2PACX-1vRD__QbJKQvCPYvxD5nSg9KwDz6K7mHGBfPfuJpPzXimyjfv2W06TqzbNxEkVaFS9NSBcVs72dhhagf/pub?gid=0&single=true&output=csv",
  track3: "https://docs.google.com/spreadsheets/d/e/2PACX-1vQNejmA5IYqCs6GeQfJP8LpNdvNw-R8U3rzVj6qEo2bGYyFUGhNGe2z-N9cMxhgqeQrXtdAStI1eeG9/pub?gid=0&single=true&output=csv",
};

const competitionLeaderboardUrls = {
  track1: { qualified: "/leaderboards/c2026/T1.json", disqualified: "/leaderboards/c2026/T1_DQ.json" },
  track2: { qualified: "/leaderboards/c2026/T2.json", disqualified: "/leaderboards/c2026/T2_DQ.json" },
  track3: { qualified: "/leaderboards/c2026/T3.json", disqualified: "/leaderboards/c2026/T3_DQ.json" },
};
---

<Layout>
  <main><section id="facts"><div class="container">
    <header class="section-header">
      <h3>2026 IEEE LPCVC Leaderboard</h3>
      <div class="leaderboard-controls">
        <div class="view-toggle" role="group" aria-label="Leaderboard type">
          <button type="button" data-view="competition">Competition</button>
          <button type="button" data-view="open">Open Submission</button>
        </div>
        <select id="contest-select" aria-label="Leaderboard track">
          <option value="track1" selected={track === "track1"}>Track 1</option>
          <option value="track2" selected={track === "track2"}>Track 2</option>
          <option value="track3" selected={track === "track3"}>Track 3</option>
          <option value="failed">Failed Jobs</option>
        </select>
      </div>
    </header>
    <div class="leaderboard-container">
      <div class="leaderboard-card"><h4>Track {track.slice(-1)} Qualified Leaderboard</h4><div id="qualified-status" class="status-text">Loading...</div><div class="table-wrapper"><table id="qualified-table" class="leaderboard-table"></table></div></div>
      <div class="leaderboard-card"><h4>Track {track.slice(-1)} Disqualified Leaderboard</h4><div id="disqualified-status" class="status-text">Loading...</div><div class="table-wrapper"><table id="disqualified-table" class="leaderboard-table"></table></div></div>
    </div>
    <script define:vars={{ track, qualifiedCsvUrls, disqualifiedCsvUrls, competitionLeaderboardUrls }}>
      const view = new URLSearchParams(window.location.search).get("view") === "open" ? "open" : "competition";
      function escapeHtml(value) { return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;"); }
      function parseCSVLine(line) { const result=[]; let current="", inQuotes=false; for(let i=0;i<line.length;i++){const char=line[i], next=line[i+1]; if(char==='"'){if(inQuotes&&next==='"'){current+='"';i++;}else inQuotes=!inQuotes;}else if(char===","&&!inQuotes){result.push(current.trim());current="";}else current+=char;} result.push(current.trim()); return result; }
      function renderTable(tableId, statusId, rows, statusText) { const table=document.getElementById(tableId), status=document.getElementById(statusId); if(!rows?.length){table.innerHTML="";status.textContent="No data available.";return;} const headers=Array.isArray(rows[0])?rows[0]:Object.keys(rows[0]); const bodyRows=Array.isArray(rows[0])?rows.slice(1):rows; table.innerHTML=`<thead><tr>${headers.map((header)=>`<th>${escapeHtml(header)}</th>`).join("")}</tr></thead><tbody>${bodyRows.map((row)=>`<tr>${headers.map((header,index)=>`<td>${escapeHtml(Array.isArray(row)?(row[index]??""):(row[header]??""))}</td>`).join("")}</tr>`).join("")}</tbody>`; status.textContent=statusText; }
      async function loadTable(url, tableId, statusId, competition) { const status=document.getElementById(statusId); try { status.textContent="Loading..."; const response=await fetch(url,{cache:competition?"force-cache":"no-store"}); if(!response.ok) throw new Error(`HTTP ${response.status}`); const rows=competition?await response.json():(await response.text()).split(/\r?\n/).map((line)=>line.trim()).filter(Boolean).map(parseCSVLine); renderTable(tableId,statusId,rows,competition?"Final competition results":`Last updated: ${new Date().toLocaleString()}`); } catch(error) { console.error(`Failed to load ${tableId}:`,error); document.getElementById(tableId).innerHTML=""; status.textContent="Failed to load leaderboard data."; } }
      function loadLeaderboards() { const competition=view==="competition"; const urls=competition?competitionLeaderboardUrls[track]:{qualified:qualifiedCsvUrls[track],disqualified:disqualifiedCsvUrls[track]}; return Promise.all([loadTable(urls.qualified,"qualified-table","qualified-status",competition),loadTable(urls.disqualified,"disqualified-table","disqualified-status",competition)]); }
      document.querySelectorAll("[data-view]").forEach((button)=>{const active=button.dataset.view===view;button.classList.toggle("active",active);button.setAttribute("aria-pressed",String(active));button.addEventListener("click",()=>window.location.href=`/2026LPCVC/leaderboard/${track}?view=${button.dataset.view}`);});
      document.getElementById("contest-select").addEventListener("change",(event)=>window.location.href=`/2026LPCVC/leaderboard/${event.target.value}${view==="open"?"?view=open":""}`);
      loadLeaderboards(); if(view==="open") setInterval(loadLeaderboards,10000);
    </script>
  </div></section></main>
</Layout>

<style>
  #facts { padding: 20px; } .container { max-width: 1200px; margin: 0 auto; } .section-header { margin-bottom: 20px; } .leaderboard-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; } .view-toggle { display: inline-flex; border: 1px solid #ccc; border-radius: 4px; overflow: hidden; } .view-toggle button { border: 0; padding: 7px 12px; background: #fff; cursor: pointer; } .view-toggle button:not(:first-child) { border-left: 1px solid #ccc; } .view-toggle button.active { background: #333; color: #fff; } select { padding: 5px; border: 1px solid #ccc; border-radius: 4px; } .leaderboard-container { display: flex; flex-direction: column; gap: 20px; } .leaderboard-card { border: 1px solid #ccc; padding: 20px; border-radius: 8px; box-shadow: 0 2px 4px rgba(0,0,0,.1); background: #fff; } .status-text { margin-bottom: 12px; font-size: 14px; color: #666; } .table-wrapper { overflow-x: auto; } .leaderboard-table { width: 100%; border-collapse: collapse; font-size: 14px; } .leaderboard-table th, .leaderboard-table td { border: 1px solid #ddd; padding: 10px 12px; text-align: left; white-space: nowrap; } .leaderboard-table th { background: #f5f5f5; font-weight: 600; } .leaderboard-table tbody tr:nth-child(even) { background: #fafafa; }
</style>
