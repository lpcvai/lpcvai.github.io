                    <li>
                      <strong>Winner:</strong> OptimAI
                      <ul>
                        <li>
                          <strong>Location:</strong> Republic of Korea
                        </li>
                        <li>
                          <strong>Organization:</strong> Korea Electronics Technology Institute
                        </li>
                        <li><strong>GitHub:</strong> <a href="" target="_blank">TBA</a></li>
                      </ul>
                    </li>
                    <li>
                      <strong>2nd Place:</strong> SSUPER_POWER
                      <ul>
                        <li><strong>Location:</strong> Republic of Korea</li>
                        <li>
                          <strong>Organization:</strong> Soongsil University
                        <li><strong>GitHub:</strong> <a href="https://github.com/LPCV-SSUPER-POWER/Track3-AI-Generated-Images-Detection" target="_blank">SSUPER-AIGID</a></li>
                      </ul>
                    </li>
                    <li>
                      <strong>3rd Place:</strong> MaXinLab
                      <ul>
                        <li>
                          <strong>Location:</strong> United States of America
                        </li>
                        <li>
                          <strong>Organization:</strong> University of California, Irvine
                        </li>
                        <li><strong>GitHub:</strong> <a href="" target="_blank">TBA</a></li>
                      </ul>
                    </li>
                    <li>
                      <strong>3rd Place:</strong> TigerSecLab (amirsalar)
                      <ul>
                        <li>
                          <strong>Location:</strong> United States of America
                        </li>
                        <li>
                          <strong>Organization:</strong> Clemson University
                        </li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/asalarpour/lpcvc2026-winning-submission" target="_blank">Link</a></li>
                      </ul>
                    </li>
                  </ul>
                </div>
              </div>
            </article>
          </div>
          <div style="padding-bottom: 25px"></div>
          <!-- add blank row -->
        </article>
      </div>
      <div style="padding-bottom: 25px"></div>
    </section>
  </main>
</Layout>
<script is:inline src="/js/main_noIndex.js"></script>