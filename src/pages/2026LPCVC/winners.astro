---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <main>
    <section id="facts">
      <div class="container">
        <article class="col-md-12">
          <div class="container">
            <header class="section-header text-center" id="data">
              <h3>2026 IEEE Low Power Computer Vision Challenge</h3>
              <h4 class="p-0"><strong>Winners</strong></h4>
            </header>
            <article class="col-md-12">
              <div class="card">
                <div class="card-body">
                  <h3>
                    Track 1: Image-to-Text Retrieval
                  </h3>
                  <ul style="list-style-type: none; padding-left: 25px;">
                    <li>
                      <strong>Winner:</strong> EfficientAI
                      <ul>
                        <li><strong>Recall@10:</strong> 0.627; <strong>Time:</strong> 16.343 ms</li>
                        <li>
                          <strong>GitHub:</strong> <a href="https://github.com/jn12-29/LPCV-Track1-EfficientAI" target="_blank">EdgeCLIP</a>, 
                          <strong>Model:</strong> <a href="https://huggingface.co/jn12/2026LPCV-Track1-MobileCLIP2-B-Best" target="_blank">Link</a>,
                          <strong>Dataset:</strong> <a href="https://huggingface.co/datasets/jn12/VG100K4CL" target="_blank">Link</a>
                        </li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>2nd Place:</strong> mangojump
                      <ul>
                        <li><strong>Recall@10:</strong> 0.612; <strong>Time:</strong> 16.708 ms</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/ching00001/lpcvc2026-track1" target="_blank">MangoCLIP</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>3rd Place:</strong> Team Manifold
                      <ul>
                        <li><strong>Recall@10:</strong> 0.605; <strong>Time:</strong> 19.350 ms</li>
                        <li>
                          <strong>GitHub:</strong> <a href="https://github.com/andrewbriand/lpcvc-final-team-manifold" target="_blank">Polyglot-CLIP</a>, 
                          <strong>Model:</strong> <a href="https://huggingface.co/jrauvola/lpcvc2026-track1-team-manifold-final" target="_blank">Link</a>,
                        </li>
                      </ul>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="card">
                <div class="card-body">
                  <h3>
                    Track 2: Action Recognition in Video
                  </h3>
                  <ul style="list-style-type: none; padding-left: 25px;">
                    <li>
                      <strong>Winner:</strong> EfficientAI
                      <ul>
                        <li><strong>Accuracy:</strong> 0.9714817047; <strong>Time:</strong> 3.82 ms</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/shuangtianxiaoye/LPCV-Track2-EfficientAI" target="_blank">EdgeViD</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>2nd Place:</strong> team-alpha
                      <ul>
                        <li><strong>Accuracy:</strong> 0.9677619171; <strong>Time:</strong> 19.322 ms</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/tasuku-takagi/LPCVC_2026_Track2_team-alpha" target="_blank">Link</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>3rd Place:</strong> CDA-IITGoa
                      <ul>
                        <li><strong>Accuracy:</strong> 0.9547427368; <strong>Time:</strong> 21.673 ms</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/vipingautam1906/LPCVC_CDA-IITGoa" target="_blank">TriMix</a></li> 
                      </ul>
                    </li>
                  </ul>
                </div>
              </div>

              <div class="card">
                <div class="card-body">
                  <h3>
                    Track 3: AI Generated Images Detection
                  </h3>
                  <ul style="list-style-type: none; padding-left: 25px;">
                    <li>
                      <strong>Winner:</strong> OptimAI
                      <ul>
                        <li><strong>Score:</strong> 0.831; <strong>Output TPS:</strong> 30.48</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/Ganzooo/LPCVC2026-Track3-OptimAI-1st" target="_blank">Link</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>2nd Place:</strong> SSUPER_POWER
                      <ul>
                        <li><strong>Score:</strong> 0.725; <strong>Output TPS:</strong> 31.21</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/LPCV-SSUPER-POWER/Track3-AI-Generated-Images-Detection" target="_blank">SSUPER-AIGID</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>3rd Place:</strong> MaXinLab
                      <ul>
                        <li><strong>Score:</strong> 0.600; <strong>Output TPS:</strong> 17.22</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/JimTheBarbarian/LPCVC_Track3_MaXinLab_Solution/tree/master" target="_blank">Link</a></li>
                      </ul>
                    </li>
                    <br />
                    <li>
                      <strong>3rd Place:</strong> TigerSecLab (amirsalar)
                      <ul>
                        <li><strong>Score:</strong> 0.646; <strong>Output TPS:</strong> 24.14</li>
                        <li><strong>GitHub:</strong> <a href="https://github.com/asalarpour/lpcvc2026-winning-submission" target="_blank">Link</a></li>
                      </ul>
                    </li>
                  </ul>
                </div>
              </div>
            </article>
          </div>
          <div style="padding-bottom: 25px"></div>
          <!-- add blank row -->
        </article>
      </div>
      <div style="padding-bottom: 25px"></div>
    </section>
  </main>
</Layout>
<script is:inline src="/js/main_noIndex.js"></script>